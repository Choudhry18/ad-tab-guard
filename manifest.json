{
  "manifest_version": 3,
  "name": "Ad Tab Guard",
  "description": "Closes unexpected cross-site tabs and reverses same-tab redirects from protected sites.",
  "version": "0.2.0",
  "icons": {
    "16": "icons/shield-16.png",
    "32": "icons/shield-32.png",
    "48": "icons/shield-48.png",
    "128": "icons/shield-128.png"
  },
  "permissions": [
    "notifications",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/shield-16.png",
      "32": "icons/shield-32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Ad Tab Guard"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_start"
    }
  ]
}
